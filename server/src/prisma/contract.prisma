// use prisma-8

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  role         UserRole
  isActive     Boolean   @default(true)
  createdAt    TimestamptzString @default(now())
  updatedAt    TimestamptzString @default(now())

  doctor       Doctor?
  patient      Patient?
}

model Hospital {
  id           Int       @id @default(autoincrement())
  name         String
  address      String?
  phone        String?
  email        String?
  createdAt    TimestamptzString @default(now())
  updatedAt    TimestamptzString @default(now())

  departments  Department[]
}

model Department {
  id           Int       @id @default(autoincrement())
  name         String
  description  String?

  hospitalId   Int
  hospital     Hospital  @relation(fields: [hospitalId], references: [id])

  doctors      Doctor[]

  createdAt    TimestamptzString @default(now())
  updatedAt    TimestamptzString @default(now())
}

model Doctor {
  id             Int       @id @default(autoincrement())
  firstName      String
  lastName       String
  specialization String
  phone          String?
  licenseNumber  String?   @unique

  userId         Int       @unique
  user           User      @relation(fields: [userId], references: [id])

  departmentId   Int
  department     Department @relation(fields: [departmentId], references: [id])

  appointments   Appointment[]
  encounters     Encounter[]

  createdAt      TimestamptzString @default(now())
  updatedAt      TimestamptzString @default(now())
}

model Patient {
  id                Int       @id @default(autoincrement())
  firstName         String
  lastName          String
  dateOfBirth       DateTime
  gender            Gender
  phone             String
  email             String?
  address           String?
  emergencyContact  String?
  bloodGroup        String?

  userId            Int?      @unique
  user              User?     @relation(fields: [userId], references: [id])

  appointments      Appointment[]
  encounters        Encounter[]

  createdAt         TimestamptzString @default(now())
  updatedAt         TimestamptzString @default(now())
}

model Appointment {
  id          Int               @id @default(autoincrement())
  appointmentAt TimestamptzString
  status      AppointmentStatus @default(SCHEDULED)
  reason      String?

  patientId   Int
  patient     Patient           @relation(fields: [patientId], references: [id])

  doctorId    Int
  doctor      Doctor            @relation(fields: [doctorId], references: [id])

  encounter   Encounter?

  createdAt   TimestamptzString @default(now())
  updatedAt   TimestamptzString @default(now())
}

model Encounter {
  id             Int       @id @default(autoincrement())
  diagnosis      String?
  clinicalNotes  String?

  appointmentId  Int       @unique
  appointment    Appointment @relation(fields: [appointmentId], references: [id])

  patientId      Int
  patient        Patient   @relation(fields: [patientId], references: [id])

  doctorId       Int
  doctor         Doctor    @relation(fields: [doctorId], references: [id])

  vitals         Vitals?
  prescriptions  Prescription[]
  labOrders      LabOrder[]
  invoice        Invoice?

  createdAt      TimestamptzString @default(now())
  updatedAt      TimestamptzString @default(now())
}

model Vitals {
  id                Int       @id @default(autoincrement())
  bloodPressure     String?
  heartRate         Int?
  temperature       Float?
  respiratoryRate   Int?
  spo2              Float?

  encounterId       Int       @unique
  encounter         Encounter @relation(fields: [encounterId], references: [id])

  recordedAt        TimestamptzString @default(now())
}

model Prescription {
  id             Int       @id @default(autoincrement())
  instructions   String?

  encounterId    Int
  encounter      Encounter @relation(fields: [encounterId], references: [id])

  items          PrescriptionItem[]

  createdAt      TimestamptzString @default(now())
}

model PrescriptionItem {
  id             Int          @id @default(autoincrement())
  medicineName   String
  dosage         String
  frequency      String
  duration       String?
  instructions   String?

  prescriptionId Int
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
}

model LabOrder {
  id             Int       @id @default(autoincrement())
  testName       String
  status         LabStatus @default(ORDERED)
  notes          String?

  encounterId    Int
  encounter      Encounter @relation(fields: [encounterId], references: [id])

  result         LabResult?

  createdAt      TimestamptzString @default(now())
  updatedAt      TimestamptzString @default(now())
}

model LabResult {
  id             Int       @id @default(autoincrement())
  resultValue    String
  referenceRange String?
  remarks        String?
  completedAt    TimestamptzString @default(now())

  labOrderId     Int       @unique
  labOrder       LabOrder  @relation(fields: [labOrderId], references: [id])
}

model Invoice {
  id             Int            @id @default(autoincrement())
  totalAmount    Float
  paymentStatus  PaymentStatus  @default(PENDING)

  encounterId    Int       @unique
  encounter      Encounter @relation(fields: [encounterId], references: [id])

  items          InvoiceItem[]

  createdAt      TimestamptzString @default(now())
  updatedAt      TimestamptzString @default(now())
}

model InvoiceItem {
  id          Int      @id @default(autoincrement())
  description String
  amount      Float

  invoiceId   Int
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
}


enum UserRole {
  ADMIN
  DOCTOR
  RECEPTIONIST
  PATIENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum LabStatus {
  ORDERED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}
